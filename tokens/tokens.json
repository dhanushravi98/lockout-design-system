{
  "meta": {
    "name": "lockout-design-system",
    "version": "0.1.0",
    "note": "Source of truth. Edit this file, then run `npm run build` and `npm run check`. Numbers are plain numbers (px on web). References look like {color.neutral.50}."
  },
  "primitive": {
    "color": {
      "white": "#FFFFFF",
      "black": "#000000",
      "blue": {
        "50": "#F0F3F9", "100": "#DEE5F2", "200": "#C1CEE7", "300": "#99AED6", "400": "#6E8CC4",
        "500": "#476BAE", "600": "#38558A", "700": "#25395C", "800": "#1F3151", "900": "#142139", "950": "#0B1422"
      },
      "neutral": {
        "50": "#F9FAFA", "100": "#F1F2F3", "200": "#E3E5E8", "300": "#CDD0D5", "400": "#A6ABB5",
        "500": "#768093", "600": "#5E6778", "700": "#484F5B", "800": "#31363F", "900": "#1F2228", "950": "#121417"
      },
      "red": {
        "50": "#FCEEEE", "100": "#F8D9D8", "200": "#F1B8B6", "300": "#E88A87", "400": "#DE5854",
        "500": "#CE2D27", "600": "#AB2521", "700": "#891E1A", "800": "#6B1714", "900": "#49100E", "950": "#2B0908"
      },
      "amber": {
        "50": "#FEF7EC", "100": "#FDEED3", "200": "#FBDEAD", "300": "#F8C977", "400": "#F5B13D",
        "500": "#E9980C", "600": "#C27E0A", "700": "#9B6508", "800": "#794F06", "900": "#523604", "950": "#302003"
      },
      "green": {
        "50": "#EFFAF3", "100": "#DBF5E5", "200": "#BCEBCD", "300": "#90DFAD", "400": "#61D18A",
        "500": "#37BE68", "600": "#2E9E57", "700": "#257E46", "800": "#1D6336", "900": "#144325", "950": "#0B2816"
      }
    },
    "space": { "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "2xl": 32, "3xl": 48, "4xl": 64 },
    "radius": { "sm": 4, "md": 8, "lg": 12, "full": 9999 },
    "size": { "control-sm": 28, "control-md": 32, "control-lg": 40 },
    "fontFamily": {
      "sans": ["Google Sans Flex", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"]
    },
    "fontSize": { "xs": 12, "sm": 14, "md": 16, "lg": 18, "xl": 20, "2xl": 24, "3xl": 32 },
    "fontWeight": { "regular": 400, "medium": 500, "semibold": 600 },
    "motion": {
      "duration": { "fast": 120, "base": 200 },
      "easing": { "standard": [0.2, 0, 0, 1] }
    },
    "text": {
      "heading-xl": { "size": "{fontSize.3xl}", "lineHeight": 40, "weight": "{fontWeight.medium}" },
      "heading-lg": { "size": "{fontSize.2xl}", "lineHeight": 32, "weight": "{fontWeight.medium}" },
      "heading-md": { "size": "{fontSize.xl}", "lineHeight": 28, "weight": "{fontWeight.medium}" },
      "heading-sm": { "size": "{fontSize.md}", "lineHeight": 24, "weight": "{fontWeight.medium}" },
      "body-lg": { "size": "{fontSize.md}", "lineHeight": 24, "weight": "{fontWeight.regular}" },
      "body": { "size": "{fontSize.sm}", "lineHeight": 20, "weight": "{fontWeight.regular}" },
      "label": { "size": "{fontSize.sm}", "lineHeight": 20, "weight": "{fontWeight.medium}" },
      "caption": { "size": "{fontSize.xs}", "lineHeight": 16, "weight": "{fontWeight.regular}" }
    }
  },
  "semantic": {
    "light": {
      "bg": {
        "page": "{color.neutral.50}",
        "surface": "{color.white}",
        "raised": "{color.white}",
        "subtle": "{color.neutral.100}"
      },
      "border": {
        "default": "{color.neutral.200}",
        "strong": "{color.neutral.300}",
        "input": "{color.neutral.500}",
        "error": "{color.red.600}"
      },
      "text": {
        "primary": "{color.neutral.900}",
        "secondary": "{color.neutral.600}",
        "disabled": "{color.neutral.400}"
      },
      "disabled": { "bg": "{color.neutral.100}", "text": "{color.neutral.400}" },
      "action": {
        "primary": {
          "bg": "{color.blue.700}", "bgHover": "{color.blue.800}", "bgPressed": "{color.blue.900}", "text": "{color.white}"
        },
        "danger": {
          "bg": "{color.red.600}", "bgHover": "{color.red.700}", "bgPressed": "{color.red.800}", "text": "{color.white}"
        },
        "link": "{color.blue.600}",
        "focusRing": "{color.blue.500}"
      },
      "nav": { "activeBg": "{color.blue.100}", "activeText": "{color.blue.800}" },
      "status": {
        "critical": { "tintBg": "{color.red.100}", "tintBorder": "{color.red.300}", "tintText": "{color.red.800}", "solidBg": "{color.red.600}", "solidText": "{color.white}" },
        "warning": { "tintBg": "{color.amber.100}", "tintBorder": "{color.amber.300}", "tintText": "{color.amber.800}", "solidBg": "{color.amber.500}", "solidText": "{color.amber.900}" },
        "normal": { "tintBg": "{color.green.100}", "tintBorder": "{color.green.300}", "tintText": "{color.green.800}", "solidBg": "{color.green.700}", "solidText": "{color.white}" },
        "offline": { "tintBg": "{color.neutral.100}", "tintBorder": "{color.neutral.300}", "tintText": "{color.neutral.800}", "solidBg": "{color.neutral.600}", "solidText": "{color.white}" },
        "info": { "tintBg": "{color.blue.100}", "tintBorder": "{color.blue.300}", "tintText": "{color.blue.800}", "solidBg": "{color.blue.600}", "solidText": "{color.white}" }
      },
      "shadow": {
        "sm": { "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0, "color": "{color.neutral.950}", "opacity": 0.08 },
        "md": { "offsetX": 0, "offsetY": 4, "blur": 12, "spread": 0, "color": "{color.neutral.950}", "opacity": 0.12 },
        "lg": { "offsetX": 0, "offsetY": 12, "blur": 32, "spread": 0, "color": "{color.neutral.950}", "opacity": 0.16 }
      }
    },
    "dark": {
      "bg": {
        "page": "{color.neutral.950}",
        "surface": "{color.neutral.900}",
        "raised": "{color.neutral.800}",
        "subtle": "{color.neutral.800}"
      },
      "border": {
        "default": "{color.neutral.700}",
        "strong": "{color.neutral.600}",
        "input": "{color.neutral.500}",
        "error": "{color.red.300}"
      },
      "text": {
        "primary": "{color.neutral.100}",
        "secondary": "{color.neutral.400}",
        "disabled": "{color.neutral.600}"
      },
      "disabled": { "bg": "{color.neutral.800}", "text": "{color.neutral.600}" },
      "action": {
        "primary": {
          "bg": "{color.blue.400}", "bgHover": "{color.blue.300}", "bgPressed": "{color.blue.200}", "text": "{color.neutral.950}"
        },
        "danger": {
          "bg": "{color.red.500}", "bgHover": "{color.red.600}", "bgPressed": "{color.red.700}", "text": "{color.white}"
        },
        "link": "{color.blue.300}",
        "focusRing": "{color.blue.300}"
      },
      "nav": { "activeBg": "{color.blue.900}", "activeText": "{color.blue.200}" },
      "status": {
        "critical": { "tintBg": "{color.red.900}", "tintBorder": "{color.red.700}", "tintText": "{color.red.200}", "solidBg": "{color.red.500}", "solidText": "{color.white}" },
        "warning": { "tintBg": "{color.amber.900}", "tintBorder": "{color.amber.700}", "tintText": "{color.amber.200}", "solidBg": "{color.amber.500}", "solidText": "{color.amber.950}" },
        "normal": { "tintBg": "{color.green.900}", "tintBorder": "{color.green.700}", "tintText": "{color.green.200}", "solidBg": "{color.green.500}", "solidText": "{color.green.950}" },
        "offline": { "tintBg": "{color.neutral.800}", "tintBorder": "{color.neutral.600}", "tintText": "{color.neutral.200}", "solidBg": "{color.neutral.400}", "solidText": "{color.neutral.950}" },
        "info": { "tintBg": "{color.blue.900}", "tintBorder": "{color.blue.700}", "tintText": "{color.blue.200}", "solidBg": "{color.blue.500}", "solidText": "{color.white}" }
      },
      "shadow": {
        "sm": { "offsetX": 0, "offsetY": 1, "blur": 2, "spread": 0, "color": "{color.black}", "opacity": 0.4 },
        "md": { "offsetX": 0, "offsetY": 4, "blur": 12, "spread": 0, "color": "{color.black}", "opacity": 0.5 },
        "lg": { "offsetX": 0, "offsetY": 12, "blur": 32, "spread": 0, "color": "{color.black}", "opacity": 0.6 }
      }
    }
  }
}
